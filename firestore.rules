rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for Master Admin UID
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.uid == "pgTnAvap3CX2h9iAhz9b5z41wbd2" ||
        request.auth.token.email == "daniyalqasmi5327@gmail.com" ||
        request.auth.token.email == "admin@emeraldhaya.com"
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Catalog & Content collection docs
    match /catalog/{docId} {
      allow read, write: if true;
    }
    match /content/{docId} {
      allow read, write: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Hero Slides & Banners
    match /heroSlides/{slideId} {
      allow read, write: if true;
    }

    // Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Newsletter Subscribers
    match /newsletter/{subscriberId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // Global Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
