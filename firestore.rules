rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Master Admin Helper (UID: pgTnAvap3CX2h9iAhz9b5z41wbd2)
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.uid == "pgTnAvap3CX2h9iAhz9b5z41wbd2" ||
        request.auth.token.email == "daniyalqasmi5327@gmail.com" ||
        request.auth.token.email == "admin@emeraldhaya.com"
      );
    }

    // Public Collections: Read/Write access for Store, Orders, Products, and Settings
    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /heroSlides/{slideId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /newsletter/{subscriberId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /catalog/{docId} {
      allow read, write: if true;
    }

    match /content/{docId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Fallback: Allows seamless real-time synchronization
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
